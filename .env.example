# Endereço público completo, com http:// ou https://, sem caminho.
# Com Caddy: http://localhost ou https://busca.exemplo.com
# Sem Caddy: http://localhost:8080 ou URL do seu proxy externo.
SITE_URL=http://localhost

# Acesso sem Caddy: use 0.0.0.0 para liberar acesso pela rede.
BIND_ADDRESS=127.0.0.1
SEARXNG_PORT=8080

# Gerada automaticamente pelo init.sh quando estiver vazia.
SEARXNG_SECRET=
